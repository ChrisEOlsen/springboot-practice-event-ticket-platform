# Copy to .env and replace the database credentials before starting.
POSTGRES_USER=template_user
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_DB=template_db

# Database port, also published on localhost for IntelliJ backend runs.
POSTGRES_PORT=5432

# Each application uses the same port inside and outside its container.
BACKEND_PORT=8080
FRONTEND_PORT=4200

# Keycloak development admin credentials (http://localhost:9090).
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_a_strong_local_password

# Create this application realm in the Keycloak admin console.
KEYCLOAK_REALM=event-ticket-platform
KEYCLOAK_ISSUER_URI=http://localhost:9090/realms/event-ticket-platform
